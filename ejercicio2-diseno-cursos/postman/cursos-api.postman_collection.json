{
  "info": {
    "name": "API de Cursos",
    "description": "Colección Postman para la API de Cursos (ejercicio2-diseno-cursos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/cursos" },
    { "key": "id", "value": "1" },
    { "key": "codigo", "value": "MAT101" }
  ],
  "item": [
    {
      "name": "Consultar cursos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        }
      }
    },
    {
      "name": "Crear curso",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Matemática I\",\n  \"codigo\": \"MAT101\",\n  \"creditos\": 4,\n  \"estado\": \"ACTIVO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}",
          "host": ["{{baseUrl}}"]
        }
      }
    },
    {
      "name": "Consultar curso por código",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/codigo/{{codigo}}",
          "host": ["{{baseUrl}}"],
          "path": ["codigo", "{{codigo}}"]
        }
      }
    },
    {
      "name": "Actualizar curso",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Matemática I\",\n  \"codigo\": \"MAT101\",\n  \"creditos\": 4,\n  \"estado\": \"INACTIVO\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{id}}"]
        }
      }
    },
    {
      "name": "Eliminar curso",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/{{id}}",
          "host": ["{{baseUrl}}"],
          "path": ["{{id}}"]
        }
      }
    }
  ]
}
